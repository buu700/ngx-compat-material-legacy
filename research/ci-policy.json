{
  "schema_version": 1,
  "implementation_status": "required-not-executed",
  "provider": "GitHub Actions",
  "runners": "standard GitHub-hosted public-repository runners",
  "toolchain_file": "toolchain-lock.json",
  "primary_node_major": 24,
  "package_manager_major": 12,
  "pr_blocking": ["toolchain-and-policy", "dependency-review", "build-api", "unit-harness", "sass-values-and-css", "migration", "packed-consumer", "chromium-high-risk-interactions"],
  "dependency_review": {"event": "pull_request", "scopes": ["runtime", "development", "unknown"]},
  "scheduled": ["extended-browser-support-matrix", "security-advisories-and-codeql", "upstream-deprecations", "angular-next-canary"],
  "canary": {"may_bypass_age_in_disposable_workspace": true, "may_update_release_lock": false, "may_publish": false, "results_must_remain_visible": true},
  "release": {"event": "protected tag or authorized dispatch", "approval_environment_required": true, "exact_tested_artifact_required": true, "oidc_stage_only": true, "interactive_2fa_approval_required": true, "untrusted_pr_cache_reuse": false},
  "first_stable": {"m2_m3_coexistence": true, "native_m3_legacy_theme": false},
  "safety": ["immutable-action-pins", "least-job-permissions", "no-untrusted-pull-request-target-execution", "no-pr-publication-identity", "no-floating-tool-installs", "no-widening-peers-to-hide-failures"]
}
