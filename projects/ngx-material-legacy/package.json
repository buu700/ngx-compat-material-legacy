{
  "name": "@ngx-compat/material-legacy",
  "version": "22.0.0-rc.0",
  "license": "MIT",
  "private": false,
  "description": "Legacy Angular Material APIs on a supported current Angular/Material/CDK stack. Development; not released.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buu700/ngx-compat-material-legacy.git",
    "note": "Repository: buu700/ngx-compat-material-legacy"
  },
  "homepage": "https://github.com/buu700/ngx-compat-material-legacy#readme",
  "bugs": {
    "url": "https://github.com/buu700/ngx-compat-material-legacy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "peerDependencies": {
    "@angular/core": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/material": "^22.1.7",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "sass": "./_index.scss"
    },
    "./_index": {
      "sass": "./_index.scss"
    }
  },
  "schematics": "./schematics/collection.json",
  "ng-update": {
    "migrations": "./schematics/migration.json"
  }
}
