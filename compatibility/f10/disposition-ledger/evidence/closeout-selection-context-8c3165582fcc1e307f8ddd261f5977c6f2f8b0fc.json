      "header": "@@ -31,7 +31,7 @@ export class Dir implements Directionality, AfterContentInit, OnDestroy {",
      "judgment": "The Dir static API metadata marks the directive standalone. Its public selector, input, output and export remain unchanged; this does not require an owned public API or a minimum-peer increase."
