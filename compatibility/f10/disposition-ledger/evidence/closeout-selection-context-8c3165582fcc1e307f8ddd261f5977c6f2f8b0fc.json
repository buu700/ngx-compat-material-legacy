      "hunk": 1,
      "file": "src/cdk/bidi/bidi-module.ts",
      "header": "@@ -10,7 +10,7 @@ import {NgModule} from '@angular/core';",
      "judgment": "BidiModule imports rather than declares standalone Dir and retains its export. Both minimum public module implementations have that exact ownership arrangement. The25 owned NgModules only reexport the public module; the isolated packed host must obtain the real directive solely through the legacy modules."
    },
    {
      "hunk": 2,
      "file": "src/cdk/bidi/bidi.md",
      "header": "@@ -7,6 +7,7 @@ When including the CDK's `BidiModule`, components can inject `Directionality` to",
      "judgment": "The documentation example gains a blank line. No exported API, consumer resource or runtime behavior changes in this hunk; retain the original documentation membership rather than omitting it from the full patch."
    },
    {
      "hunk": 3,
      "file": "src/cdk/bidi/bidi.md",
      "header": "@@ -32,12 +33,14 @@ export class MyWidget implements OnDestroy {",
      "judgment": "The Dir and auto-direction documentation sections gain blank lines. The nearest-ancestor Directionality contract remains explicit; actual legacy field/input provider identity is required by the packed case. Locale-specific auto behavior is covered only by the disclosed whole-module diagnostic here."
    },
    {
      "hunk": 4,
      "file": "src/cdk/bidi/dir.ts",
      "header": "@@ -21,6 +21,7 @@ import {Direction, Directionality, _resolveDirectionality} from './directionalit",
      "judgment": "Dir becomes standalone while keeping its selector, provider alias, host raw attribute, export name and input/output declarations. Both minimum peer implementations preserve these public contracts. Own no directive mirror or private CDK helper; real node/provider/output observations remain mandatory."
    },
    {
      "hunk": 5,
      "file": "src/cdk/bidi/directionality.spec.ts",
      "header": "@@ -10,8 +10,8 @@ describe('Directionality', () => {",
      "judgment": "The upstream test hosts move from declarations to imports together with BidiModule. This is upstream standalone fixture wiring, not a legacy product migration. The add-on retains its historical NgModule exports and compiles a separately isolated actual consumer host."
    },
    {
      "hunk": 6,
      "file": "src/cdk/bidi/directionality.spec.ts",
      "header": "@@ -157,12 +157,25 @@ describe('Directionality', () => {",
      "judgment": "The injected-directionality host becomes standalone and the parent host explicitly imports Dir and that child. These changes preserve scope-aware injection in the upstream regression. The add-on packed isolation deliberately imports only the two legacy modules, so unrelated current-module imports cannot supply the directive."
    },
    {
      "hunk": 7,
      "file": "src/cdk/bidi/directionality.spec.ts",
      "header": "@@ -172,6 +185,8 @@ class ElementWithDir {",
      "judgment": "The predefined-auto host becomes standalone and imports Dir. This is a test-scope change; no new auto resolver is owned. Original/current whole-module diagnostics retain their explicit auto-locale scope and limits."
    },
    {
      "hunk": 8,
      "file": "src/cdk/bidi/directionality.spec.ts",
      "header": "@@ -179,20 +194,13 @@ class ElementWithPredefinedAutoDir {",
      "judgment": "The predefined-uppercase host becomes standalone with Dir and the previous child declaration is removed after its relocation. Uppercase and invalid/empty public updates are independently required in the isolated packed case; no fixture class is transplanted into product code."
    },
    {
      "hunk": 9,
      "file": "tools/public_api_guard/cdk/bidi.md",
      "header": "@@ -17,7 +17,7 @@ export class BidiModule {",
      "judgment": "The BidiModule static API metadata moves Dir from the declarations slot into the imports slot while retaining exports. Both exact minimum declaration bundles are inspected. Static metadata inspection alone cannot qualify Angular consumer scope, hence the mandatory packed compile/run."
    },
    {
      "hunk": 10,
