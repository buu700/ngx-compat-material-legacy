     }
 
     this._typeaheadSubscription.unsubscribe();
@@ -403,6 +407,7 @@ export class ListKeyManager<T extends ListKeyManagerOption> {
   destroy() {
     this._typeaheadSubscription.unsubscribe();
     this._itemChangesSubscription?.unsubscribe();
