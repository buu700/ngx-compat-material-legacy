@@ -108,11 +110,11 @@ export class CdkOption<T = unknown> implements ListKeyManagerOption, Highlightab
     get disabled(): boolean;
     set disabled(value: boolean);
     readonly element: HTMLElement;
-    get enabledTabIndex(): number | null;
