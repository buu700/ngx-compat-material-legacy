 src/cdk/a11y/live-announcer/live-announcer.ts                 | 4 ++--
 10 files changed, 20 insertions(+), 20 deletions(-)

diff --git a/src/cdk/a11y/aria-describer/aria-describer.ts b/src/cdk/a11y/aria-describer/aria-describer.ts
