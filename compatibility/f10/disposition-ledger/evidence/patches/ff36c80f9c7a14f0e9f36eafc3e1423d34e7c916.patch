+
+describe('TreeKeyManager', () => {
+  let fakeKeyEvents: {
+    downArrow: KeyboardEvent;
+    upArrow: KeyboardEvent;
+    leftArrow: KeyboardEvent;
+    rightArrow: KeyboardEvent;
+    tab: KeyboardEvent;
+    home: KeyboardEvent;
