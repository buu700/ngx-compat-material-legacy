  "diff": "diff --git a/src/material/tabs/tab-body.ts b/src/material/tabs/tab-body.ts\nindex a52281986e79c4ec0123b23e7009190e59a0fbe1..e9f3ecc5d32539340a9a98accdb1e707970bd43e 100644\n--- a/src/material/tabs/tab-body.ts\n+++ b/src/material/tabs/tab-body.ts\n@@ -26,7 +26,7 @@ import {\n   inject,\n } from '@angular/core';\n import {Subject, Subscription} from 'rxjs';\n-import {distinctUntilChanged, startWith} from 'rxjs/operators';\n+import {startWith} from 'rxjs/operators';\n import {matTabsAnimations} from './tabs-animations';\n \n /**\n@@ -174,24 +174,16 @@ export class MatTabBody implements OnInit, OnDestroy {\n       });\n     }\n \n-    // Ensure that we get unique animation events, because the `.done` callback can get\n-    // invoked twice in some browsers. See https://github.com/angular/angular/issues/24084.\n-    this._translateTabComplete\n-      .pipe(\n-        distinctUntilChanged((x, y) => {\n-          return x.fromState === y.fromState && x.toState === y.toState;\n-        }),\n-      )\n-      .subscribe(event => {\n-        // If the transition to the center is complete, emit an event.\n-        if (this._isCenterPosition(event.toState) && this._isCenterPosition(this._position)) {\n-          this._onCentered.emit();\n-        }\n+    this._translateTabComplete.subscribe(event => {\n+      // If the transition to the center is complete, emit an event.\n+      if (this._isCenterPosition(event.toState) && this._isCenterPosition(this._position)) {\n+        this._onCentered.emit();\n+      }\n \n-        if (this._isCenterPosition(event.fromState) && !this._isCenterPosition(this._position)) {\n-          this._afterLeavingCenter.emit();\n-        }\n-      });\n+      if (this._isCenterPosition(event.fromState) && !this._isCenterPosition(this._position)) {\n+        this._afterLeavingCenter.emit();\n+      }\n+    });\n   }\n \n   /**\n",
  "diff_sha256": "8c5c7c7e24faef142a0320faf51bd61cecd10c7e06eeeeb15ddc0f53cb654083",
  "hunk_reviews": [
    {
      "path": "src/material/tabs/tab-body.ts",
      "header": "@@ -26,7 +26,7 @@ import {",
      "hunk_sha256": "7068f6d2b038ac8fd5ea581fd89df4a2a44eb9bf934d53e83351c42e09799be4",
      "judgment": "The operator import removal belongs to the same upstream removal of the completion-state filter. The owned source keeps the stable public rxjs/operators distinctUntilChanged import, compatible with the existing RxJS peer range. No modern peer constructor, animation-engine helper, private import or consumer API migration is introduced."
    },
    {
      "path": "src/material/tabs/tab-body.ts",
      "header": "@@ -174,24 +174,16 @@ export class MatTabBody implements OnInit, OnDestroy {",
      "hunk_sha256": "be438418832d87a2f0fba80632f324d83dbaf0eeaec5b266c3f12f94ce3f673c",
      "judgment": "The constructor hunk removes both-state equality filtering while preserving the centered/leaving checks. The complete untouched historical base and actual owned base produce the same output histories for duplicate center/leave, real repeated cycles, changed source/destination, obsolete state and both origin names. Removing the filter changes those reference observations and is rejected. The current owned motion lifecycle is tested independently with47 cases/22 rejected mutants; the public group animationDone path and portal detach wiring remain. Keep the original output contract and require genuine trusted native completion on all registered modes/engines/runtimes."
    }
  ],
  "decision": "Retain the complete historical completion subscription, including distinctUntilChanged on both state names and the existing asynchronous centered output. Removing the RxJS operator changes the untouched Material16 output contract under duplicate callbacks; both exact minimum current peer methods belong to the modern component and are not the legacy subscription contract. The current owned source preserves this filter and constructor/output metadata while separately repairing incoming/departing and newly created origin lifecycle timing. Require trusted native incoming/departing/both-origin transitions, correct height, exactly-once public completion and cleanup in the complete same-run native matrix. Source protocols and historical replay do not qualify native execution.",
