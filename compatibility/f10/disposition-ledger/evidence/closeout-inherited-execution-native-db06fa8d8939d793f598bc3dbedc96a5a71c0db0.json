  "hunk_reviews": [
    {
      "path": "src/material/autocomplete/autocomplete-trigger.ts",
      "header": "@@ -132,8 +132,8 @@ export class MatAutocompleteTrigger",
      "hunk_sha256": "826df65ce9c5d16b865e85fe7e017518aae89f865665819f27d5c4b71f3bc80c",
      "judgment": "The field and comment change distinguish attached overlay state from visible options. The owned field is _valueOnAttach; empty options do not prevent capture. This is owned legacy behavior, not delegated to the current Material directive."
    },
    {
      "path": "src/material/autocomplete/autocomplete-trigger.ts",
      "header": "@@ -589,6 +589,7 @@ export class MatAutocompleteTrigger",
      "hunk_sha256": "c52a31ba1e3f83dc058f21d07cb337912b1b4c2edc62dca692b5a10994efa465",
      "judgment": "The upstream option-change stream captures when the panel becomes visible. The candidate keeps the later stable attachment snapshot instead of recapturing through this branch; no option visibility event is required for its initial capture. This review qualifies the original empty-option preservation boundary, not equivalence for all subsequent option-list timing."
    },
    {
      "path": "src/material/autocomplete/autocomplete-trigger.ts",
      "header": "@@ -611,10 +612,14 @@ export class MatAutocompleteTrigger",
      "hunk_sha256": "b34dae9ad0f55a1ab9581af115aa4045186e14e056ea2ee5a426401399ec69cf",
      "judgment": "The original helper moves value capture out of opened emission. The tagged16 source already contains that helper. Candidate _emitOpened only emits, while _attachOverlay performs inline capture once per actual attachment. The former claim that the current candidate contains _captureValueOnAttach is corrected."
    },
    {
      "path": "src/material/autocomplete/autocomplete-trigger.ts",
      "header": "@@ -665,7 +670,10 @@ export class MatAutocompleteTrigger",
      "hunk_sha256": "ab48df2aea4f056a632be3f6cea5ea5fc7127ffb8f1caa808d46eaa81bd8983c",
      "judgment": "Required-selection dismissal compares native text with the captured attachment value. Unchanged text retains the selected object and display; changed unmatched text clears once. Selection-event and optional-mode paths remain separate and are included as source diagnostic controls."
    },
    {
      "path": "src/material/autocomplete/autocomplete-trigger.ts",
      "header": "@@ -727,8 +735,8 @@ export class MatAutocompleteTrigger",
      "hunk_sha256": "d8292bb2acd5eff7f3e58ecb7ae9fe2309e38c300a88fa08aa107a21daf5420b",
      "judgment": "The attachment path captures even when panelOpen is false because options are empty. Candidate capture occurs inside the actual unattached-overlay attach branch before closing subscription registration, and both authenticated public floor source prototypes have that same arrangement. First overlay creation and native event routing remain required artifact work."
    },
    {
      "path": "src/material/autocomplete/autocomplete.spec.ts",
      "header": "@@ -2663,6 +2663,37 @@ describe('MDC-based MatAutocomplete', () => {",
      "hunk_sha256": "b77e206a6f91fe67fcfe04c79ef125ed48b2553ca5f39010129e98b8f8466ded",
      "judgment": "The complete added upstream regression selects California, removes all options, opens the invisible panel, dismisses by document click and requires unchanged display/model with no option selection. Existing named legacy #172 now covers those observations and retains its original direct close not-to-throw assertion. All other test identities/bodies are preserved; native execution remains mandatory."
    }
  ],
