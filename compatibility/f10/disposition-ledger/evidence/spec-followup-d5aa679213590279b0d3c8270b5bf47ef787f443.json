  "raw_commit_sha256": "4ac8c47414ed1dc4b4d81133d4b2ecb4d45baab699a815b23d620f1287ca5015",
  "diff": "diff --git a/src/material/autocomplete/autocomplete.spec.ts b/src/material/autocomplete/autocomplete.spec.ts\nindex 14c9533d15285756879b7c0d8073dbb3609d68fc..3905e4c90b971e03371844fca996914ead43c894 100644\n--- a/src/material/autocomplete/autocomplete.spec.ts\n+++ b/src/material/autocomplete/autocomplete.spec.ts\n@@ -2544,6 +2544,8 @@ describe('MDC-based MatAutocomplete', () => {\n         // Safari seems to require an extra round that other browsers don't.\n         await new Promise(r => setTimeout(r));\n         fixture.detectChanges();\n+        await new Promise(r => setTimeout(r));\n+        fixture.detectChanges();\n       };\n \n       await flushPosition();\n",
  "diff_sha256": "d4ec28d4464444301d54259f4d26a1ffbb5b3d46cb7184ef6e466536eaa53b56",
  "hunk_reviews": [
    {
      "path": "src/material/autocomplete/autocomplete.spec.ts",
      "header": "@@ -2544,6 +2544,8 @@ describe('MDC-based MatAutocomplete', () => {",
      "sha256": "7057325f9e7d133910047a06c6e641c5bb394d80096a1729cd8ca66f3defaaed",
      "judgment": "The only hunk adds await setTimeout followed by fixture.detectChanges after the existing Safari round. The complete async helper is used before initial measurement, after filtering to one option and after clearing the input. The legacy fakeAsync test has two geometry assertions and a different rendering/zone protocol. Preserve both comparisons and require actual browser results before changing timing."
    }
  ],
  "semantics": {
    "kind": "async-test-render-synchronization",
    "added_timer_render_pairs": 1,
    "assertions_and_case_names_preserved": true,
    "runtime_scheduling_change": true,
    "before_cases": 183,
    "after_cases": 183,
    "before_assertions": 444,
    "after_assertions": 444
  },
  "decision": "The complete original autocomplete patch adds one real timer turn and render pass to the modern async flushPosition helper used by the reposition-on-options-change regression. All183 case names and444 assertion statements are preserved in that upstream file, but scheduling changes; this is not type-only. The complete retained legacy spec has the corresponding below/above positioning assertions in a fakeAsync test using tick, simulateZoneExit and the original legacy form-field/panel selectors. It has no async flushPosition helper. Keep that historical test and all assertions. Do not copy a modern Safari retry into a different scheduler without an observed failure. Actual Safari and artifact execution of the retained regression remain required; no cross-browser or inherited-fix claim follows from this source decision.",
  "individual_proof": {
    "proof_kind": "individual-complete-spec-source-applicability",
    "diff_sha256": "d4ec28d4464444301d54259f4d26a1ffbb5b3d46cb7184ef6e466536eaa53b56",
