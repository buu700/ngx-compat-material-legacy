  "diff": "diff --git a/src/material/divider/divider.spec.ts b/src/material/divider/divider.spec.ts\nindex b0197e5e59293feda4474ad88025d52fa0f6df45..b64417fb1145bde45cdc885f52e95a7c2a19c124 100644\n--- a/src/material/divider/divider.spec.ts\n+++ b/src/material/divider/divider.spec.ts\n@@ -62,6 +62,6 @@ describe('MatDivider', () => {\n   imports: [MatDividerModule],\n })\n class MatDividerTestComponent {\n-  vertical: boolean;\n-  inset: boolean;\n+  vertical = false;\n+  inset = false;\n }\n",
