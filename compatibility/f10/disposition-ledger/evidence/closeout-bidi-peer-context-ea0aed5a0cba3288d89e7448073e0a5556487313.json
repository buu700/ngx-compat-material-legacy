  "hunk_reviews": [
    {
      "hunk": 1,
      "file": "src/material/menu/menu.ts",
      "header": "@@ -31,7 +31,7 @@ import {",
      "judgment": "The original import adds _IdGenerator beside public focus utilities. The add-on must keep its stable public focus boundaries and its manual constructor; it imports no underscore generator. The exact minimum public peer menu owns that dependency independently."
    },
    {
      "hunk": 2,
      "file": "src/material/menu/menu.ts",
      "header": "@@ -50,8 +50,6 @@ import {throwMatMenuInvalidPositionX, throwMatMenuInvalidPositionY} from './menu",
      "judgment": "Removing the modern module counter cannot make the separate historical counter share current service state. Retaining two unsuffixed counters was empirically shown to collide; the already implemented owned suffix separates those namespaces while retaining the historical monotonic default-ID model."
    },
    {
      "hunk": 3,
      "file": "src/material/menu/menu.ts",
      "header": "@@ -270,7 +268,7 @@ export class MatMenu implements AfterContentInit, MatMenuPanel<MatMenuItem>, OnI",
      "judgment": "The panelId initialization switches the modern component to injected getId(mat-menu-panel-). Both minimum public peers retain that call with default non-randomized generation. The owned field remains a constructor-independent counter template with a legacy suffix. Required actual packed observations check exact own menu panel nodes and trigger aria-controls in both creation orders; broad prefix matching or a nonempty ID cannot pass."
    }
  ],
  "source_conclusion": "The complete menu ID-generator patch is adapted through an owned historical default-ID namespace, preserving the original explicit constructor and every HTML/CSS/SCSS byte. Both minimum current public menus use their private service with the same mat-menu-panel prefix and an independent counter; the earlier real constructor evidence reproduced collisions in both generation orders before the owned suffix repair. Owned panelId now retains its monotonic counter and mat-menu-panel prefix with a legacy suffix, while real trigger aria-controls must resolve exactly to its own panel. No private service, new injectable dependency, modern API mirror or ordinary menu fork is introduced. Constructor-only observations cannot qualify node identity or overlay cleanup: require the actual full packed case in the same current clean artifact run, including both creation orders, own nodes/ARIA, menu open/close and cleanup. Full native motion and peer-floor gates remain mandatory.",
  "decision": "The complete menu ID-generator patch is adapted through an owned historical default-ID namespace, preserving the original explicit constructor and every HTML/CSS/SCSS byte. Both minimum current public menus use their private service with the same mat-menu-panel prefix and an independent counter; the earlier real constructor evidence reproduced collisions in both generation orders before the owned suffix repair. Owned panelId now retains its monotonic counter and mat-menu-panel prefix with a legacy suffix, while real trigger aria-controls must resolve exactly to its own panel. No private service, new injectable dependency, modern API mirror or ordinary menu fork is introduced. Constructor-only observations cannot qualify node identity or overlay cleanup: require the actual full packed case in the same current clean artifact run, including both creation orders, own nodes/ARIA, menu open/close and cleanup. Full native motion and peer-floor gates remain mandatory.",
