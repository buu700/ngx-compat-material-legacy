  "diff": "diff --git a/src/material/core/theming/tests/m3-theme.spec.ts b/src/material/core/theming/tests/m3-theme.spec.ts\nindex 52c867f8052589af773b222ee840269138194789..e05486afb2009d585ae8d891b92762b8e4c80d43 100644\n--- a/src/material/core/theming/tests/m3-theme.spec.ts\n+++ b/src/material/core/theming/tests/m3-theme.spec.ts\n@@ -1,4 +1,4 @@\n-import {parse, Rule} from 'postcss';\n+import {parse} from 'postcss';\n import {compileString} from 'sass';\n import {runfiles} from '@bazel/runfiles';\n import * as path from 'path';\n",
