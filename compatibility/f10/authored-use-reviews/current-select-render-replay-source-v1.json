        "file": "legacy-select/internal/after-select-render.ts",
        "module": "@angular/core",
        "symbol": "Injector",
        "candidate_source_sha256": "10a2bbbe02fb0a4578646e802888a5e075bb909a36fd1c19049b5fa2d731e570",
        "conclusion": "stable-public-peer",
        "reviewer": "Codex primary implementer",
        "decision": "The type-only optional Injector parameter remains nullable and uses exactly one stable public get(ApplicationRef, null) lookup. The same supplied reference is passed to afterNextRender; no injector is created or destroyed. Existing manual construction can omit it and retain the zone-only route. Real current applications exercise stable zoneless initialization, zoneful timing, once-only completion, panel/font source-member behavior and teardown with explicit host/overlay/option protocols. Strict actual-helper compilation selects nondeprecated generic get. This closes only the borrowed public Injector dependency; separate hook/application dependencies, actual legacy select node factories/providers, native panel geometry and packed/runtime floors remain pending.",
        "source_binding": {
          "file": "legacy-select/internal/after-select-render.ts",
          "module": "@angular/core",
          "symbol": "Injector",
          "family": "select",
          "candidate_source_sha256": "10a2bbbe02fb0a4578646e802888a5e075bb909a36fd1c19049b5fa2d731e570",
          "helper": "export function afterSelectRender(zone: NgZone, injector?: Injector | null): Observable<void> {\n  return new Observable<void>(subscriber => {\n    const stable = zone.onStable.subscribe(() => subscriber.next());\n    // The trailing optional injector preserves historical manual construction.\n    let rendered: AfterRenderRef | null = null;\n    try {\n      if (injector?.get(ApplicationRef, null)) {\n        rendered = afterNextRender(() => {\n          if (zone.isStable) {\n            subscriber.next();\n          }\n        }, {injector});\n      }\n    } catch (error) {\n      stable.unsubscribe();\n      throw error;\n    }\n\n    return () => {\n      stable.unsubscribe();\n      rendered?.destroy();\n    };\n  }).pipe(take(1));\n}",
          "gets": [
            "injector?.get(ApplicationRef, null)"
          ],
          "renders": [
            "afterNextRender(() => {\n          if (zone.isStable) {\n            subscriber.next();\n          }\n        }, {injector})"
          ],
          "ownership": "Borrow supplied injector; only the returned render registration is destroyed",
          "capture": false
        },
