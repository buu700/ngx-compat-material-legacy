+      "full_diff_sha256": "d8cc92177a14d0838bcd09916b8f5d6dc547853aa04051447db6ebc0d3e5ce80",
+      "full_diff": "diff --git a/projects/ngx-material-legacy/legacy-menu/internal/menu-base.ts b/projects/ngx-material-legacy/legacy-menu/internal/menu-base.ts\nindex 9e6e9ea11..10ce08dbf 100644\n--- a/projects/ngx-material-legacy/legacy-menu/internal/menu-base.ts\n+++ b/projects/ngx-material-legacy/legacy-menu/internal/menu-base.ts\n@@ -9,6 +9,7 @@\n  * Owned Material-16 `_MatMenuBase` (removed from Angular Material 22).\n  */\n \n+import {_LegacyMenuItemBase as MatMenuItem} from './menu-item-base';\n import {\n   AfterContentInit,\n   ChangeDetectionStrategy,\n@@ -63,8 +64,8 @@ import {startWith, switchMap, take} from 'rxjs/operators';\n import {\n   MAT_MENU_CONTENT,\n   MAT_MENU_DEFAULT_OPTIONS,\n+  MatMenuItem as PeerMatMenuItem,\n   MatMenuDefaultOptions,\n-  MatMenuItem,\n   MenuCloseReason,\n   MenuPositionX,\n   MenuPositionY,\n@@ -91,7 +92,7 @@ export class _MatMenuBase\n   protected _baseElevation: number;\n \n   /** All items inside the menu. Includes items nested inside another menu. */\n-  @ContentChildren(MatMenuItem, {descendants: true}) _allItems: QueryList<MatMenuItem>;\n+  @ContentChildren(PeerMatMenuItem, {descendants: true}) _allItems: QueryList<MatMenuItem>;\n \n   /** Only the direct descendant menu items. */\n   _directDescendantItems = new QueryList<MatMenuItem>();\n@@ -115,7 +116,7 @@ export class _MatMenuBase\n   readonly _animationDone = new Subject<LegacyMenuAnimationEvent>();\n \n   /** Whether the menu is animating. */\n-  _isAnimating: boolean;\n+  _isAnimating = false;\n \n   /** Parent menu of the current menu panel. */\n   parentMenu: MatMenuPanel | undefined;\n@@ -176,7 +177,7 @@ export class _MatMenuBase\n    * @deprecated\n    * @breaking-change 8.0.0\n    */\n-  @ContentChildren(MatMenuItem, {descendants: false}) items: QueryList<MatMenuItem>;\n+  @ContentChildren(PeerMatMenuItem, {descendants: false}) items: QueryList<MatMenuItem>;\n \n   /**\n    * Menu content that will be rendered lazily.\n@@ -257,7 +258,7 @@ export class _MatMenuBase\n    */\n   @Output() readonly close: EventEmitter<MenuCloseReason> = this.closed;\n \n-  readonly panelId = `mat-menu-panel-${menuPanelUid++}`;\n+  readonly panelId = `mat-menu-panel-${menuPanelUid++}-legacy`;\n \n   constructor(\n     elementRef: ElementRef<HTMLElement>,\n@@ -357,6 +358,8 @@ export class _MatMenuBase\n     this._clearExitFallback();\n     this._isAnimating = false;\n     this._animationDone.complete();\n+    // A public key-manager change observer may destroy the menu before focus() resumes.\n+    this._keyManager?.updateActiveItem(-1);\n     this._keyManager?.destroy();\n     this._directDescendantItems.destroy();\n     this.closed.complete();\n@@ -419,6 +422,7 @@ export class _MatMenuBase\n         manager.onKeydown(event);\n         return;\n     }\n+    event.stopPropagation();\n   }\n \n   /**\n@@ -426,20 +430,21 @@ export class _MatMenuBase\n    * @param origin Action from which the focus originated. Used to set the correct styling.\n    */\n   focusFirstItem(origin: FocusOrigin = 'program'): void {\n+    if (this._motionDestroyed) return;\n     // Wait for `onStable` to ensure iOS VoiceOver screen reader focuses the first item (#24735).\n     // An already-stable zone never emits onStable. Noop token providers do not schedule an\n     // animation task, so a click-open would otherwise leave focus on document.body.\n     this._firstItemFocusSubscription?.unsubscribe();\n-    let applied = false;\n+    const request = new Subscription();\n+    this._firstItemFocusSubscription = request;\n     const apply = () => {\n-      if (applied) {\n+      if (request.closed || this._motionDestroyed) {\n         return;\n       }\n-      applied = true;\n-      this._firstItemFocusSubscription?.unsubscribe();\n+      request.unsubscribe();\n       this._applyFirstItemFocus(origin);\n     };\n-    this._firstItemFocusSubscription = this._ngZone.onStable.pipe(take(1)).subscribe(apply);\n+    request.add(this._ngZone.onStable.pipe(take(1)).subscribe(apply));\n     if (this._ngZone.isStable) {\n       Promise.resolve().then(apply);\n     }\n@@ -460,6 +465,7 @@ export class _MatMenuBase\n     if (!menuPanel || !menuPanel.contains(document.activeElement)) {\n       const manager = this._keyManager;\n       manager.setFocusOrigin(origin).setFirstItemActive();\n+      if (this._motionDestroyed) return;\n \n       // If there's no active item at this point, it means that all the items are disabled.\n       // Move focus to the menuPanel panel so keyboard events like Escape still work. Also this will\n@@ -541,6 +547,7 @@ export class _MatMenuBase\n     if (this._motionDestroyed) {\n       return;\n     }\n+    this._firstItemFocusSubscription?.unsubscribe();\n     const sequence = ++this._motionSequence;\n     this._clearExitFallback();\n     this._completedAnimation = undefined;\n"
+    },
+    {
+      "path": "tests/snack_exit_runtime_subject.mjs",
+      "prior_commit": "9a4b48c95d5574c963d5dfb3df1695eab4999a25",
