+"""Intermediate source history controls in a private copied fixture."""
+import hashlib,json,os,secrets,subprocess,sys,tempfile,unittest
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT/'scripts'))
+from current_sass_tool_inventory_history import CurrentSassToolInventoryHistory,PACKETS
+
+class SassToolInventoryHistoryTests(unittest.TestCase):
+    def test_committed_comparisons_and_callback_controls(self):
+        with tempfile.TemporaryDirectory(prefix='ngx-sass-tool-inventory-history-') as temp:
+            parent=Path(temp);root=parent/'source';sibling=parent/'sibling';root.mkdir(mode=0o700);sibling.mkdir(mode=0o700)
+            nonce=secrets.token_hex(16);marker=parent/'owner-nonce';marker.write_text(nonce);marker.chmod(0o600)
+            gitdir=subprocess.check_output(['git','rev-parse','--absolute-git-dir'],cwd=ROOT,text=True).strip()
+            for dest in (root,sibling):
+                for path,_,_ in PACKETS:
+                    target=dest/path;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes((ROOT/path).read_bytes())
+                (dest/'.git').write_text('gitdir: '+gitdir+'\n');(dest/'.git').chmod(0o444)
+            first=PACKETS[0][0];last=PACKETS[-1][0];mode='';holder=None;other=None
+            def read(path):
+                raw=(root/path).read_bytes()
+                if mode=='wrong' and path==last:return raw+b'x'
+                if mode=='reentry' and path==last:
+                    try:holder.assert_current()
+                    except AssertionError:pass
+                if mode=='cross' and path==last:
+                    try:other.assert_current()
+                    except AssertionError:pass
+                if mode=='cold' and path==last:
+                    try:CurrentSassToolInventoryHistory(root)
+                    except AssertionError:pass
+                if mode=='sibling' and path==last:CurrentSassToolInventoryHistory(sibling).assert_current()
+                if mode=='closing' and path==last:(root/first).write_bytes(b'changed')
+                return raw
+            mode='cold'
+            with self.assertRaises(AssertionError):CurrentSassToolInventoryHistory(root,read=read)
+            mode='';holder=CurrentSassToolInventoryHistory(root,read=read);other=CurrentSassToolInventoryHistory(root);self.assertEqual(len(holder.transitions),6)
+            ref=holder.transitions[0]['before'];self.assertEqual(len(holder.comparison_bytes(ref)),ref['bytes'])
+            with self.assertRaises(KeyError):holder.comparison_bytes({**ref,'sha256':'0'*64})
+            for bad in ('wrong','reentry','cross'):
+                mode=bad
+                with self.assertRaises(AssertionError):holder.assert_current()
+                mode='';holder.assert_current()
+            mode='sibling';holder.assert_current();mode='';holder.assert_current()
+            original=(root/first).read_bytes()
