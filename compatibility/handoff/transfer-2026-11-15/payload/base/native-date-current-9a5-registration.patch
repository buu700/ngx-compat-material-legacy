 import {validateNativeDate,NATIVE_DATE_SHA,nativeDateRequirements} from '../scripts/upstream-native-date-evidence.mjs';
 const source=resolve(dirname(fileURLToPath(import.meta.url)),'..'), read=p=>readFileSync(join(source,p));
 const hash=b=>createHash('sha256').update(b).digest('hex');
+// Recover both complete committed source transitions, retaining every unrelated byte.
+const historical=path=>execFileSync('git',['show','4903a80fc76cd3b57b806a9b89003f5b1545baa5:'+path],{cwd:source,maxBuffer:20*1024*1024}).toString();
+const once=(text,before,after)=>{assert.equal(text.split(before).length,2);return text.replace(before,()=>after);};
