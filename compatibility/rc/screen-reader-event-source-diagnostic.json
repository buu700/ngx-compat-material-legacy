          "line": 124,
          "expression": "isFakeTouchstartFromScreenReader(event)",
          "member": "_handleTouchStart",
          "member_source": "private _handleTouchStart = (event: TouchEvent) => {\n    if (!isFakeTouchstartFromScreenReader(event)) {\n      this._openedBy = 'touch';\n    }\n  };"
        }
