          "line": 291,
          "expression": "isFakeMousedownFromScreenReader(event)",
          "member": "_onMousedown",
          "member_source": "private _onMousedown(event: MouseEvent) {\n    const isFakeMousedown = isFakeMousedownFromScreenReader(event);\n    const isSyntheticEvent =\n      this._lastTouchStartEvent && Date.now() < this._lastTouchStartEvent + ignoreMouseEventsTimeout;\n\n    if (!this._target.rippleDisabled && !isFakeMousedown && !isSyntheticEvent) {\n      this._isPointerDown = true;\n      this.fadeInRipple(event.clientX, event.clientY, this._target.rippleConfig);\n    }\n  }"
        }
      ]
    },
    {
      "file": "legacy-core/ripple/ripple-renderer.ts",
