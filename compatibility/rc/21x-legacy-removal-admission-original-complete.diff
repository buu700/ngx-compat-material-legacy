-    MatLegacyChipsModule,
-    MatLegacyFormFieldModule,
-    MatIconModule,
-    MatToolbarModule,
-  ],
-})
-export class LegacyChipsDemo {
-  tabIndex = 0;
-  visible = true;
-  color: ThemePalette;
-  selectable = true;
-  removable = true;
-  addOnBlur = true;
-  message = '';
-
-  // Enter, comma, semi-colon
-  separatorKeysCodes = [ENTER, COMMA, 186];
-
-  selectedPeople = null;
-
-  people: Person[] = [
-    {name: 'Kara'},
-    {name: 'Jeremy'},
-    {name: 'Topher'},
-    {name: 'Elad'},
-    {name: 'Kristiyan'},
-    {name: 'Paul'},
-  ];
-
-  availableColors: DemoColor[] = [
-    {name: 'none', color: undefined},
-    {name: 'Primary', color: 'primary'},
-    {name: 'Accent', color: 'accent'},
-    {name: 'Warn', color: 'warn'},
-  ];
-
-  displayMessage(message: string): void {
-    this.message = message;
-  }
-
-  add(event: MatLegacyChipInputEvent): void {
-    const value = (event.value || '').trim();
-
-    // Add our person
-    if (value) {
-      this.people.push({name: value});
-    }
-
-    // Clear the input value
-    event.chipInput!.clear();
-  }
-
-  remove(person: Person): void {
-    const index = this.people.indexOf(person);
-
-    if (index >= 0) {
-      this.people.splice(index, 1);
-    }
-  }
-
-  removeColor(color: DemoColor) {
-    let index = this.availableColors.indexOf(color);
-
-    if (index >= 0) {
-      this.availableColors.splice(index, 1);
-    }
-
-    index = this.selectedColors.indexOf(color.name);
-
-    if (index >= 0) {
-      this.selectedColors.splice(index, 1);
-    }
-  }
-
-  toggleVisible(): void {
-    this.visible = false;
-  }
-  selectedColors: string[] = ['Primary', 'Warn'];
-  selectedColor = 'Accent';
-}
