-
-  name: string;
-  errorMessageExample1: string;
-  errorMessageExample2: string;
-  errorMessageExample3: string;
-  errorMessageExample4: string;
-  dividerColorExample1: string;
-  dividerColorExample2: string;
-  dividerColorExample3: string;
