-
-export interface Person {
-  name: string;
-}
-
-export interface DemoColor {
-  name: string;
-  color: ThemePalette;
-}
-
-@Component({
-  selector: 'legacy-chips-demo',
-  templateUrl: 'legacy-chips-demo.html',
-  styleUrls: ['legacy-chips-demo.css'],
