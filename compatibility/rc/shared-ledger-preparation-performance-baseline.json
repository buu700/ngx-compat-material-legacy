      "source": "import {readFileSync,writeFileSync} from 'node:fs';\nimport {join} from 'node:path';\nimport {pathToFileURL} from 'node:url';\nimport {performance} from 'node:perf_hooks';\nconst root=process.cwd(),start=performance.now(),{preparePackedUpstreamLedger}=await import(pathToFileURL(join(root,'scripts/packed-upstream-ledger-epoch.mjs')));\nconst imported=performance.now(),cpu=process.cpuUsage(),prepared=preparePackedUpstreamLedger({root});\nconst done=performance.now(),usage=process.cpuUsage(cpu);\nif(!prepared.canonical_after.equals(readFileSync(join(root,'compatibility/f10/disposition-ledger/ledger.json'))))throw new Error('actual canonical after differs');\nconst report={schema_version:1,line:prepared.line,role:'One actual read-only ledger preparation, not a full regression pass.',node:process.version,module_load_ms:Math.round(imported-start),preparation_ms:Math.round(done-imported),preparation_cpu_user_ms:Math.round(usage.user/1000),preparation_cpu_system_ms:Math.round(usage.system/1000),bound_current_members:prepared.bound.size,canonical_after_bytes:prepared.canonical_after.length,memory:process.memoryUsage(),canonical_after_matches_actual:true,actual_native_artifact_browser_floor_or_audit_qualified:false};\nwriteFileSync(process.argv[2],JSON.stringify(report,null,2)+'\\n',{flag:'wx'});console.log(JSON.stringify(report));\n"
