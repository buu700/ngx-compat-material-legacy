      "source": "import {readFileSync,writeFileSync} from 'node:fs';\nimport {join} from 'node:path';\nimport {pathToFileURL} from 'node:url';\nimport {performance} from 'node:perf_hooks';\nconst root=process.cwd(),{preparePackedUpstreamLedger}=await import(pathToFileURL(join(root,'scripts/packed-upstream-ledger-epoch.mjs'))),runs=[];\nfor(let n=0;n<2;n++){\n const counts=new Map();let total=0,calls=0;\n const read=path=>{const raw=readFileSync(join(root,path)),record=counts.get(path)??{path,calls:0,bytes:0};record.calls++;record.bytes+=raw.length;counts.set(path,record);calls++;total+=raw.length;return raw;};\n const started=performance.now(),prepared=preparePackedUpstreamLedger({root,read}),elapsed=performance.now()-started;\n if(!prepared.canonical_after.equals(readFileSync(join(root,'compatibility/f10/disposition-ledger/ledger.json'))))throw new Error('canonical mismatch');\n const result={iteration:n+1,preparation_ms:Math.round(elapsed),actual_read_callback_calls:calls,unique_callback_paths:counts.size,total_callback_bytes:total,bound_members:prepared.bound.size,top_callback_bytes:[...counts.values()].sort((a,b)=>b.bytes-a.bytes).slice(0,12),canonical_after_matches_actual:true};runs.push(result);console.log(JSON.stringify({iteration:result.iteration,ms:result.preparation_ms,calls,bytes:total}));\n}\nwriteFileSync(process.argv[2],JSON.stringify({schema_version:1,node:process.version,runs,source_scope_only:true,full_regression_pass_claimed:false},null,2)+'\\n',{flag:'wx'});\n"
