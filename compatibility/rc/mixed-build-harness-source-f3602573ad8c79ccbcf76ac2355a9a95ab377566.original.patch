-    super.visitMethodDeclaration(method);
-  }
-
-  /** Checks whether a property access is operating on a `SimpleChanges` object. */
-  private _isSimpleChangesAccess(method: ts.MethodDeclaration, node: ts.PropertyAccessExpression) {
