{
  "schema_version": 1,
  "line": "21.x",
  "role": "Bounded stable peer API maintenance, not a consumer Sass migration. Remove only the unused planned-removal argument; namespace/helper names, selectors, contents and maps unchanged.",
  "calls": 52,
  "files": 30,
  "peer21": {
    "version": "21.2.14",
