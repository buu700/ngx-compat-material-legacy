        "references": [
          {
            "line": 41,
            "expression": "Component({\n  standalone: false,\n  selector: 'mat-table, table[mat-table]',\n  exportAs: 'matTable',\n  template: `\n    <ng-content select=\"caption\"></ng-content>\n    <ng-content select=\"colgroup, col\"></ng-content>\n\n    @if (_isServer) {\n      <ng-content></ng-content>\n    }\n\n    @if (_isNativeHtmlTable) {\n      <thead role=\"rowgroup\">\n        <ng-container legacyTableOutlet=\"header\"></ng-container>\n      </thead>\n      <tbody role=\"rowgroup\">\n        <ng-container legacyTableOutlet=\"data\"></ng-container>\n        <ng-container legacyTableOutlet=\"empty\"></ng-container>\n      </tbody>\n      <tfoot role=\"rowgroup\">\n        <ng-container legacyTableOutlet=\"footer\"></ng-container>\n      </tfoot>\n    } @else {\n      <ng-container legacyTableOutlet=\"header\"></ng-container>\n      <ng-container legacyTableOutlet=\"data\"></ng-container>\n      <ng-container legacyTableOutlet=\"empty\"></ng-container>\n      <ng-container legacyTableOutlet=\"footer\"></ng-container>\n    }\n  `,\n  styleUrls: ['table.scss'],\n  host: {\n    'class': 'mat-table',\n    '[class.mat-table-fixed-layout]': 'fixedLayout',\n    'ngSkipHydration': '',\n  },\n  providers: [\n    {provide: CdkTable, useExisting: MatLegacyTable},\n    {provide: STICKY_POSITIONING_LISTENER, useValue: null},\n  ],\n  encapsulation: ViewEncapsulation.None,\n  // See note on CdkTable for explanation on why this uses the default change detection strategy.\n  // tslint:disable-next-line:validate-decorators\n  changeDetection: ChangeDetectionStrategy.Eager,\n})",
            "target_class": "MatLegacyTable",
            "fields": [
              "standalone",
              "selector",
              "exportAs",
              "template",
              "styleUrls",
              "host",
              "providers",
